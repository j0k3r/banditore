# Copy to .env.docker and replace each placeholder before starting Compose.
# Generate secrets with: openssl rand -hex 32
APP_SECRET=replace-with-a-random-secret
GITHUB_CLIENT_ID=replace-with-your-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-your-oauth-client-secret

# Use URL-safe passwords (hexadecimal secrets work without URL encoding).
DATABASE_PASSWORD=replace-with-a-random-database-password
DATABASE_ROOT_PASSWORD=replace-with-a-different-random-password

APP_PORT=8000
PROJECT_HOST=localhost:8000
PROJECT_SCHEME=http
